
<style>
table{page-break-inside:auto;}
tr{page-break-inside:avoid;page-break-after:auto;}
thead{display:table-header-group;}
tfoot{display:table-footer-group;}

.relatorio{
    width:1300px;
    margin:auto;
    font-family:Tahoma, Geneva, sans-serif;
    font-size:11px;
    line-height:20px;
}
.filtros{
    width:100%;
    font-size:11px;
    line-height:20px;
    font-weight:normal;
}
.filtros ul{
    list-style:none;
    width:100%;
    height:100%;
    margin:0;
    padding:0;
}
.filtros li{
    float:left;
}
.filtro_nome{
    width:70px;
    text-align:right;
}
.filtro_info{
    width:176px;
    text-align:left;
}
.relatorio_logo{
    float:left;
    width:150px;
    text-align:left;
}
.relatorio_titulo{
    float:left;
    width:80%;
    margin-top:6px;
    text-align:center;
}
.relatorio_info{
    float:right;
    font-weight:normal;
    line-height:12px;
    text-align:right;
    width:150px;
    font-size:10px;
    margin-top:7px;
}
.td_titulo{
    border-top:solid 2px #333;
    border-bottom:solid 2px #333;
    background:#E5E5E5;
}
.td_total{
    border-top:solid 1px #333;
    font-weight:bold;
}
.resultado{
    width:740px;
    margin:auto;
    margin-top:20px;    
}
.tb_result{
    float:left;
    font-family:Tahoma, Geneva, sans-serif;
    font-size:11px;
    line-height:20px;
    margin-top:5px;
}
.td_titulo_resumo{
    border-bottom:solid 2px #333;
}
.align_left{
    text-align:left;    
}
.align_right{
    text-align:right;    
}
.align_center{
    text-align:center;    
}
</style>

